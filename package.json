{
  "name": "zkplayer-desktop",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "tauri": "tauri",
    "build:tauri": "npm run build && npx tauri build",
    "build:tauri:signed": "npm run build:tauri && node scripts/sign-bundle.mjs",
    "build:tauri:debug": "npm run build && npx tauri build --debug",
    "sign:bundle": "node scripts/sign-bundle.mjs",
    "release:latest-json": "node scripts/generate-latest-json.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "tauri:signer:generate": "cd src-tauri && npx tauri signer generate -w tauri.key -p \"\" -f"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-process": "2.2.0",
    "@tauri-apps/plugin-updater": "2.3.0",
    "hls.js": "^1.5.20",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.2"
  }
}
